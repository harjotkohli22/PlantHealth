{
  "name": "plant-health-lib",
  "version": "1.0.1",
  "description": "A comprehensive React Native library for plant disease detection using TensorFlow Lite",
  "private": false,
  "license": "MIT",
  "author": "Kulwindar Singh",
  "keywords": [
    "plant-health",
    "disease-detection",
    "react-native",
    "tflite",
    "tensorflow",
    "plant-care",
    "mobile-vision"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./components": {
      "types": "./lib/components/index.d.ts",
      "default": "./lib/components/index.js"
    },
    "./hooks": {
      "types": "./lib/hooks/index.d.ts",
      "default": "./lib/hooks/index.js"
    },
    "./services": {
      "types": "./lib/services/index.d.ts",
      "default": "./lib/services/index.js"
    },
    "./theme": {
      "types": "./lib/theme/index.d.ts",
      "default": "./lib/theme/index.js"
    },
    "./utils": {
      "types": "./lib/utils/index.d.ts",
      "default": "./lib/utils/index.js"
    },
    "./screens": {
      "types": "./lib/screens/index.d.ts",
      "default": "./lib/screens/index.js"
    },
    "./UI": {
      "types": "./lib/UI.d.ts",
      "default": "./lib/UI.js"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "cd ios && pod install && cd ..",
    "lint": "eslint .",
    "test": "jest",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "jpeg-js": "^0.4.4",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-fast-tflite": "1.6.1",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "2.21.2",
    "react-native-image-picker": "7.2.3",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "5.1.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.10.1",
    "react-native-vision-camera": "4.7.3",
    "react-native-worklets-core": "1.6.3",
    "vision-camera-resize-plugin": "3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "7.25.0",
    "@react-native-community/cli": "14.1.0",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@types/jpeg-js": "^0.3.7",
    "@types/react": "18.3.12",
    "eslint": "8.57.0",
    "jest": "29.6.3",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kulwindar_singh/plant-health-lib.git"
  },
  "homepage": "https://github.com/kulwindar_singh/plant-health-lib#readme",
  "bugs": {
    "url": "https://github.com/kulwindar_singh/plant-health-lib/issues"
  }
}
